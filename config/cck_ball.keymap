#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    // 左右滚动编码器行为
    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };
    
    behaviors {
    };

    // Orca echo の「fn1(赤)+fn2(緑)」同時押しで BT レイヤー(5)を有効化 ※推測
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: 黒印字 / Layer 1: 赤印字(fn1) / Layer 2: 緑印字(fn2)
        // Layer 3,4 は overlay の scroll-layers / snipe-layers 用なので位置を変えない
        orca_base {
            display-name = "Orca Base";
            bindings = <
            &none            &none            &none            &none            &none            &mo 2            &none            &none            &none            &none            &none            &none
            &kp ESC          &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P            &kp BSPC
            &kp TAB          &kp A            &kp S            &kp D            &lt 3 F            &kp G            &kp H            &kp J            &kp K            &kp L            &kp SEMI         &kp ENTER
            &kp LSHFT        &kp Z            &kp X            &kp C            &kp V            &kp B            &kp N            &kp M            &kp COMMA        &kp DOT          &kp LS(N8)       &kp LS(N9)
            &kp LCTRL        &kp LALT         &kp LGUI         &mo 1            &kp SPACE        &kp DELETE       &mo 2            &kp SPACE        &kp MINUS        &mkp LCLK        &mkp RCLK        &mkp MCLK
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        orca_fn1 {
            display-name = "Orca fn1 (red)";
            bindings = <
            &kp F12           &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6           &kp F7           &kp F8           &kp F9           &kp F10           &kp F11
            &trans           &trans           &trans           &kp UP           &trans           &trans           &trans           &kp C_PP         &trans           &kp N7           &kp N8           &kp N9
            &trans           &trans           &kp LEFT         &kp DOWN         &kp RIGHT        &trans           &trans           &kp C_PREV       &kp C_NEXT       &kp N4           &kp N5           &kp N6
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp LANG2        &kp LANG1        &kp N1           &kp N2           &kp N3
            &trans           &trans           &trans           &trans           &trans           &trans           &mkp LCLK        &mkp RCLK        &trans           &kp N0           &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        orca_fn2 {
            display-name = "Orca fn2 (green)";
            bindings = <
            &trans           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &trans           &trans           &trans           &trans           &trans           &kp W
            &trans           &kp LS(N1)       &kp LS(N2)       &kp LS(N3)       &kp LS(N4)       &kp LS(N5)       &kp LS(N6)       &kp LS(N7)       &kp LS(N8)       &kp LS(N9)       &kp LS(MINUS)    &kp LS(EQUAL)
            &trans           &kp LBKT         &kp LS(LBKT)     &kp RBKT         &kp NON_US_HASH  &kp LS(RBKT)     &kp LS(NON_US_HASH) &kp MINUS        &kp EQUAL        &kp INT3         &kp SQT          &kp LS(SQT)  // JIS: @ ` [ ] { } - ^ ¥ : *
            &trans           &kp LS(COMMA)    &kp LS(DOT)      &kp LS(FSLH)     &kp FSLH         &kp INT1         &kp LS(INT1)     &kp LS(SEMI)     &kp SEMI         &kp LS(INT3)     &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll-layers {
            display-name = "Scroll";
            bindings = <
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            display-name = "Snipe";
            bindings = <
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            >;

            sensor-bindings = <&scroll_vertical_encoder>,   // 编码器1：上下滚动
                             <&scroll_horizontal_encoder>;  // 编码器2：左右滚动
        };

        orca_bt {
            display-name = "Orca BT (gray, guess)";
            bindings = <
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &bt BT_CLR_ALL   &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp LG(LS(N4))   &kp LG(LS(N5))   &trans           &trans
            &trans           &trans           &trans           &trans           &trans           &trans           &trans           &trans           &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
